@{
    ViewBag.Title = "Liên hệ với chúng tôi";
}

<main class="container my-5">
    <!-- Tiêu đề -->
    <section class="text-center mb-5">
        <h1 class="fw-bold text-primary">@ViewBag.Title</h1>
        <p class="lead text-muted">Chúng tôi luôn sẵn sàng lắng nghe và hỗ trợ bạn mọi lúc mọi nơi.</p>
    </section>

    <div class="row g-4">
        <!-- Thông tin liên hệ -->
        <div class="col-lg-5">
            <div class="p-4 bg-light rounded-4 shadow-sm h-100">
                <h4 class="fw-semibold mb-4">Thông tin cửa hàng</h4>
                <p><i class="bi bi-geo-alt-fill text-primary me-2"></i>123 Đường Nguyễn Huệ, Quận 1, TP. Hồ Chí Minh</p>
                <p><i class="bi bi-telephone-fill text-primary me-2"></i>(+84) 987 654 321</p>
                <p><i class="bi bi-envelope-fill text-primary me-2"></i>support@myshop.vn</p>
                <p><i class="bi bi-clock-fill text-primary me-2"></i>Thứ 2 - Chủ nhật: 8:00 - 21:00</p>
                    
                <div class="mt-4">
                    <h6 class="fw-bold mb-2">Theo dõi chúng tôi:</h6>
                    <a href="#" class="text-primary fs-5 me-3"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="text-danger fs-5 me-3"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="text-info fs-5"><i class="bi bi-twitter"></i></a>
                </div>
            </div>
        </div>

        <!-- Form liên hệ -->
        <div class="col-lg-7">
            <div class="p-4 border rounded-4 shadow-sm bg-white">
                <h4 class="fw-semibold mb-4">Gửi tin nhắn cho chúng tôi</h4>

                <form method="post" action="@Url.Action("SendCont   act", "Home")">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="Name" class="form-label fw-semibold">Họ và tên</label>
                            <input type="text" class="form-control" id="Name" name="Name" placeholder="Nhập họ tên của bạn" required>
                        </div>
                        <div class="col-md-6">
                            <label for="Email" class="form-label fw-semibold">Email</label>
                            <input type="email" class="form-control" id="Email" name="Email" placeholder="you@example.com" required>
                        </div>
                        <div class="col-12">
                            <label for="Subject" class="form-label fw-semibold">Chủ đề</label>
                            <input type="text" class="form-control" id="Subject" name="Subject" placeholder="Nhập chủ đề liên hệ" required>
                        </div>
                        <div class="col-12">
                            <label for="Message" class="form-label fw-semibold">Nội dung</label>
                            <textarea class="form-control" id="Message" name="Message" rows="5" placeholder="Viết nội dung liên hệ của bạn..." required></textarea>
                        </div>
                    </div>

                    <div class="mt-4 text-end">
                        <button type="submit" class="btn btn-primary px-4 py-2 rounded-pill">
                            <i class="bi bi-send-fill me-1"></i> Gửi ngay
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Bản đồ -->
    <section class="mt-5">
        <h4 class="fw-semibold mb-3 text-center">Bản đồ vị trí cửa hàng</h4>
        <div class="ratio ratio-16x9 shadow rounded-4 overflow-hidden">
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3919.5026347699747!2d106.70042387503693!3d10.772215859292826!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31752f3f58c12345%3A0x7b8dfd4b2a7b7a0!2sNguyen%20Hue%20Street!5e0!3m2!1svi!2s!4v1709452373841!5m2!1svi!2s"
                    style="border:0;" allowfullscreen="" loading="lazy"></iframe>
        </div>
    </section>
</main>
